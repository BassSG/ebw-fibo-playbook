//@version=6
indicator("EBW-Fibo 1.10.9 • Leg Context", "EBW 1.10.9", overlay = true, max_lines_count = 220, max_labels_count = 260, max_boxes_count = 10, max_bars_back = 2000, calc_bars_count = 2000, dynamic_requests = true)

const string GT = "00 · แผงฟิโบแต่ละ TF"
bool uiTFPanel = input.bool(true, "แผงฟิโบล่าสุดแต่ละ TF", group = GT, tooltip = "ชุดล่าสุดหลัง Break; ไม่มีชุดซ่อนแถว ไม่ใช่แนวโน้ม/จุดเข้า", display = display.none)
bool uiTFD = input.bool(true, "1D", inline = "tfa", group = GT, active = uiTFPanel, display = display.none)
bool uiTF4H = input.bool(true, "4H", inline = "tfa", group = GT, active = uiTFPanel, display = display.none)
bool uiTF1H = input.bool(true, "1H", inline = "tfa", group = GT, active = uiTFPanel, display = display.none)
bool uiTF15 = input.bool(true, "15m", inline = "tfb", group = GT, active = uiTFPanel, display = display.none)
bool uiTF5 = input.bool(true, "5m", inline = "tfb", group = GT, active = uiTFPanel, display = display.none)
bool uiTF1 = input.bool(true, "1m", inline = "tfb", group = GT, active = uiTFPanel, display = display.none)
string uiDetail = input.string("ปิด", "รายละเอียดบนแผง", options = ["ปิด", "สถานะ TF", "หลักฐานชุด"], group = GT, display = display.none)
string uiInspectTF = input.timeframe("60", "TF ที่ตรวจรายละเอียด", group = GT, active = uiDetail != "ปิด", display = display.none)
int uiPanelGap = input.int(3, "เว้นหัวแผง (แถว) · หลบชื่อกราฟ", minval = 0, maxval = 6, group = GT, display = display.none)
bool uiBookContext = input.bool(true, "FLOW · บทบาทขาเล็กกับขาใหญ่", group = GT, tooltip = "คู่ล่าสุดที่เปิดเส้น: ขาใหญ่สุด + ขาที่เล็กลงใกล้สุด อ่าน RSI/Sto จากแท่งต้นทางปิด รอข้อมูลครอบคลุมขา; SHIFT? เป็นเฝ้าระวังก่อน Break ใหญ่", display = display.none)
bool uiCycleWatch = input.bool(true, "CYCLE · พักรอบ / เฝ้าปลายขา", group = GT, tooltip = "เฝ้าชุดล่าสุดของ TF ใหญ่สุดที่เปิดเส้น ใช้เป้าที่ถึง + Di ขาเดียว + Form/ชุดย่อยสวน ข้อมูลไม่พอซ่อนแถว รายละเอียดใน tooltip", display = display.none)

string G0 = "01 · เปิด / ปิดระบบ"
bool uiBoard = input.bool(false, "Dashboard · รายละเอียดที่มีข้อมูล", group = G0, display = display.none)
bool uiLinks = input.bool(true, "แผง TF พระเอก / ความสัมพันธ์ที่ตรวจพบ", group = G0, display = display.none)
bool uiEW = input.bool(true, "EW · ผลตรวจราคาที่ชัดเจนบนแผง", group = G0, display = display.none)
bool uiEWManual = input.bool(false, "EW · ตรวจจุดที่เลือกเองเพิ่มเติม", group = G0, display = display.none)
bool uiEWChannel = input.bool(false, "EW · Channel ของ Impulse ที่เลือกเอง", group = G0, display = display.none)
bool uiFrames = input.bool(true, "กรอบปรับฐานที่ผ่านเงื่อนไข", group = G0, display = display.none)
bool uiTargets = input.bool(true, "Fibonacci หาเป้า (หลัง Break เท่านั้น)", group = G0, display = display.none)
bool uiAnchors = input.bool(true, "จุดยึดฟิโบ + เส้นเชื่อมสวิง", group = G0, display = display.none)
bool uiRetrace = input.bool(false, "Fibonacci Retrace / Gauge", group = G0, display = display.none)
bool uiZones = input.bool(true, "โซนสุญญากาศ 261.8–423.6", group = G0, display = display.none)
bool uiTS = input.bool(false, "เส้น Trailing Stop / Cut (ไม่มีป้าย Action)", group = G0, display = display.none)
bool uiInvalid = input.bool(false, "ข้อความเมื่อชุดฟิโบถูกทำลาย", group = G0, display = display.none)
bool uiDiv = input.bool(false, "Regular + Hidden divergence", group = G0, display = display.none)
bool uiCycles = input.bool(false, "จุดรอบ Stochastic / RSI", group = G0, display = display.none)
bool uiMTF = input.bool(true, "กรอบและเป้า TF ใหญ่ที่เลือก", group = G0, display = display.none)
bool uiClusters = input.bool(true, "Cluster จากชุดฟิโบที่ยังมีผล", group = G0, display = display.none)
bool uiRetained = input.bool(true, "แสดงชุดเดิมที่ยังมีเป้ารอเพิ่มเติม", group = G0, tooltip = "เก็บชุดเดิมที่ยังใช้ได้ร่วมกับชุดใหม่ สูงสุด 3 records ต่อ TF รวมย้อนหลัง; MATRIX อ่านชุดล่าสุด เป้าที่เคยถึงไม่เป็นเป้ารอ/Cluster ใหม่", display = display.none)
bool uiStructureEvidence = input.bool(true, "Cluster เพิ่ม High/Low เดิม + Gap จริง", group = G0, display = display.none)

string G1 = "02 · ค่าหนังสือ / การยืนยัน"
int rLen = input.int(14, "RSI", minval = 2, maxval = 100, group = G1, display = display.none)
int kLen = input.int(9, "Stochastic length", minval = 2, maxval = 100, group = G1, display = display.none)
int kSmooth = input.int(3, "Smooth K", minval = 1, maxval = 20, group = G1, display = display.none)
int dSmooth = input.int(3, "Smooth D", minval = 1, maxval = 20, group = G1, display = display.none)
float rOS = input.float(30, "RSI OS", minval = 1, maxval = 49, group = G1, display = display.none)
float rOB = input.float(70, "RSI OB", minval = 51, maxval = 99, group = G1, display = display.none)
float kOS = input.float(20, "Stochastic OS", minval = 1, maxval = 49, group = G1, display = display.none)
float kOB = input.float(80, "Stochastic OB", minval = 51, maxval = 99, group = G1, display = display.none)
string breakMode = input.string("Wick ของแท่งปิด", "Break กรอบ", options = ["Wick ของแท่งปิด", "Close ของแท่งปิด"], group = G1, display = display.none)
bool allowNeck = input.bool(true, "กรอบหักคอ: ต้องมี Regular divergence ในรอบ", group = G1, display = display.none)
int divLen = input.int(3, "ยืนยัน pivot สำหรับ Divergence เท่านั้น", minval = 1, maxval = 20, group = G1, display = display.none)

string G2 = "03 · เชื่อม Time Frame"
string tf1 = input.timeframe("240", "TF ใหญ่ 1", group = G2, display = display.none)
string tf2 = input.timeframe("D", "TF ใหญ่ 2", group = G2, display = display.none)
string controlTF = input.string("TF ใหญ่ 1", "บริบทสำหรับ Action 2–5", options = ["TF ใหญ่ 1", "TF ใหญ่ 2"], group = G2, display = display.none)
float linkATR = input.float(0.03, "คลาดเคลื่อนจุดร่วม (ATR ของ TF ใหญ่)", minval = 0, maxval = 0.2, step = 0.01, group = G2, display = display.none)
bool requireLink = input.bool(true, "Action 2–5 ต้องผ่านความสัมพันธ์ขาราคา", group = G2, display = display.none)
string boardCorner = input.string("ขวาบน", "ตำแหน่งแผง", options = ["ขวาบน", "ซ้ายบน", "ขวาล่าง"], group = G2, display = display.none)

string GH = "03A · TF พระเอก — ช่วงราคาอ้างอิง"
string heroRefTF = input.timeframe("60", "TF อ้างอิงรอบราคา (ไม่ใช่ TF พระเอก)", group = GH, display = display.none)
string heroRefMode = input.string("Auto · ขาจากรอบ Sto ล่าสุด", "ช่วงที่ต้องการหาพระเอก", options = ["Auto · ขาจากรอบ Sto ล่าสุด", "เลือกจุดเริ่มเอง → ราคาล่าสุด"], group = GH, display = display.none)
float heroStartP = input.float(0, "ราคาจุดเริ่ม M / N", inline = "href", group = GH, active = heroRefMode == "เลือกจุดเริ่มเอง → ราคาล่าสุด", display = display.none)
int heroStartT = input.time(0, "เวลาจุดเริ่ม", inline = "href", group = GH, active = heroRefMode == "เลือกจุดเริ่มเอง → ราคาล่าสุด", display = display.none)

string G3 = "04 · Action 5 ท่า / เครื่องมือวางแผน"
bool act1 = input.bool(true, "A1 · บริบท Current + Trailing Start", group = G3, display = display.none)
bool act2 = input.bool(true, "A2 · บริบท TF ใหญ่ + Regular divergence Current + TS", group = G3, display = display.none)
bool act3 = input.bool(true, "A3 · บริบท TF ใหญ่ + Form Current + TS", group = G3, display = display.none)
bool act4 = input.bool(true, "A4 · บริบท TF ใหญ่ + Break Form Current", group = G3, display = display.none)
bool act5 = input.bool(true, "A5 · Gap ข้าม Form + Break แท่งแรก", group = G3, display = display.none)

string G4 = "05 · Fibonacci / ภาพ"
string fibChoice = input.string("สองจุด B→C เท่านั้น", "วิธีหาเป้า · ล็อกสองจุด", options = ["สองจุด B→C เท่านั้น"], group = G4, active = false, display = display.none)
bool overrideD = input.bool(false, "ใช้ D อ้างอิงใหญ่ที่เลือกเอง (เฉพาะ Current)", group = G4, display = display.none)
float manualD = input.float(0, "ราคา D ก่อน A", group = G4, active = overrideD, display = display.none)
int manualDT = input.time(0, "เวลา D ก่อน A", group = G4, active = overrideD, display = display.none)
int reach = input.int(8, "ระยะป้ายไปทางขวา (แท่ง)", minval = 1, maxval = 100, group = G4, display = display.none)
bool uiInner = input.bool(false, "เป้า: แสดงระดับย่อย 38.2–78.6%", group = G4, display = display.none)
bool uiLabels = input.bool(true, "ราคา / ป้ายระดับ", group = G4, display = display.none)
bool stickLabels = input.bool(true, "ป้ายชิดแท่งล่าสุด (เหมาะกับจอแคบ)", group = G4, display = display.none)
bool pairLabels = input.bool(true, "รวมป้าย 350% / 361.8% ที่อยู่ใกล้กัน", group = G4, display = display.none)
string labelScale = input.string("ปกติ", "ขนาดตัวอักษร", options = ["เล็ก", "ปกติ", "ใหญ่"], group = G4, display = display.none)

string G5 = "06 · Elliott — ตรวจราคา ไม่ยืนยันคลื่นย่อย"
string ewKind = input.string("Impulse 0–5", "แบบที่ตรวจ", options = ["Impulse 0–5", "Zigzag 0–A–B–C", "Flat 0–A–B–C", "Diagonal 0–5", "Triangle 0–A–B–C–D–E"], group = G5, active = uiEWManual, display = display.none)
string ewDiag = input.string("Ending 5/C", "ตำแหน่ง Diagonal ที่ผู้ใช้เลือก", options = ["Ending 5/C", "Leading 1/A"], group = G5, active = uiEWManual and ewKind == "Diagonal 0–5", display = display.none)
string ewTriangle = input.string("Contracting", "ชนิด Triangle", options = ["Contracting", "Barrier", "Expanding"], group = G5, active = uiEWManual and ewKind == "Triangle 0–A–B–C–D–E", display = display.none)
float ew0 = input.float(0, "จุด 0", inline = "w0", group = G5, active = uiEWManual, display = display.none)
int et0 = input.time(0, "เวลา", inline = "w0", group = G5, active = uiEWManual, display = display.none)
float ew1 = input.float(0, "จุด 1 / A", inline = "w1", group = G5, active = uiEWManual, display = display.none)
int et1 = input.time(0, "เวลา", inline = "w1", group = G5, active = uiEWManual, display = display.none)
float ew2 = input.float(0, "จุด 2 / B", inline = "w2", group = G5, active = uiEWManual, display = display.none)
int et2 = input.time(0, "เวลา", inline = "w2", group = G5, active = uiEWManual, display = display.none)
float ew3 = input.float(0, "จุด 3 / C", inline = "w3", group = G5, active = uiEWManual, display = display.none)
int et3 = input.time(0, "เวลา", inline = "w3", group = G5, active = uiEWManual, display = display.none)
float ew4 = input.float(0, "จุด 4 / D", inline = "w4", group = G5, active = uiEWManual and (ewKind == "Impulse 0–5" or ewKind == "Diagonal 0–5" or ewKind == "Triangle 0–A–B–C–D–E"), display = display.none)
int et4 = input.time(0, "เวลา", inline = "w4", group = G5, active = uiEWManual and (ewKind == "Impulse 0–5" or ewKind == "Diagonal 0–5" or ewKind == "Triangle 0–A–B–C–D–E"), display = display.none)
float ew5 = input.float(0, "จุด 5 / E", inline = "w5", group = G5, active = uiEWManual and (ewKind == "Impulse 0–5" or ewKind == "Diagonal 0–5" or ewKind == "Triangle 0–A–B–C–D–E"), display = display.none)
int et5 = input.time(0, "เวลา", inline = "w5", group = G5, active = uiEWManual and (ewKind == "Impulse 0–5" or ewKind == "Diagonal 0–5" or ewKind == "Triangle 0–A–B–C–D–E"), display = display.none)

string visualMode = input.string("สะอาด", "รูปแบบการแสดงผล", options = ["สะอาด", "ละเอียด"], group = G0, display = display.none)
bool uiHeroOnly = input.bool(true, "แผงกระชับ · พระเอก + ฟิโบแต่ละ TF", group = G0, tooltip = "พระเอก+TF กลุ่ม 00; ปิดดูแถวเพิ่ม", display = display.none)

bool rb_enabled = input.bool(false, "Retrace ขาใหญ่ + Cluster กับเป้าฟิโบ", group = G0, display = display.none)
const string RB_GROUP = "09 · Retrace ขาใหญ่ / Cluster ทั้งระบบ"
string rb_mode = input.string("Auto · ขาแม่ของฟิโบหาเป้า", "เลือกขาใหญ่", options = ["Auto · ขาแม่ของฟิโบหาเป้า", "Auto · รอบ Sto ของ TF ที่เลือก", "เลือก 100% / 0% เอง"], group = RB_GROUP, active = rb_enabled, display = display.none)
bool rb_parentAuto = rb_mode == "Auto · ขาแม่ของฟิโบหาเป้า"
string rb_tf = input.timeframe("60", "TF ของขาใหญ่ (ไม่เปลี่ยนตามกราฟ)", group = RB_GROUP, active = rb_enabled and rb_mode == "Auto · รอบ Sto ของ TF ที่เลือก", display = display.none)
float rb_fromP = input.float(0, "100% · ราคาจุดเริ่มขาใหญ่", inline = "rb100", group = RB_GROUP, active = rb_enabled and rb_mode == "เลือก 100% / 0% เอง", display = display.none)
int rb_fromT = input.time(0, "เวลา 100%", inline = "rb100", group = RB_GROUP, active = rb_enabled and rb_mode == "เลือก 100% / 0% เอง", display = display.none)
float rb_toP = input.float(0, "0% · ราคาจุดจบขาใหญ่", inline = "rb0", group = RB_GROUP, active = rb_enabled and rb_mode == "เลือก 100% / 0% เอง", display = display.none)
int rb_toT = input.time(0, "เวลา 0%", inline = "rb0", group = RB_GROUP, active = rb_enabled and rb_mode == "เลือก 100% / 0% เอง", display = display.none)
string rb_view = input.string("เส้น + Cluster", "แสดง", options = ["เส้น + Cluster", "เฉพาะ Cluster", "เฉพาะเส้น"], group = RB_GROUP, active = rb_enabled, display = display.none)
string rb_scope = input.string("Current + TF ใหญ่ 1/2", "เป้าที่นำมาเทียบ Retrace", options = ["ชุดฟิโบที่เปิดแสดง", "Current + TF ใหญ่ 1/2"], group = RB_GROUP, active = rb_enabled, display = display.none)
float rb_tolerance = input.float(0.25, "Cluster ทั้งระบบ · ความผ่อนปรน ATR ต้นทาง", minval = 0, maxval = 2, step = 0.05, group = RB_GROUP, active = rb_enabled or uiClusters, display = display.none)
bool rb_markers = input.bool(true, "แสดงจุด 100% / 0% ของขาใหญ่", group = RB_GROUP, active = rb_enabled, display = display.none)
bool rb_debug = input.bool(false, "แสดงสถานะ Retrace / สาเหตุที่ยังไม่แสดง", group = RB_GROUP, active = rb_enabled, display = display.none)
const string rb_matchMode = "Adaptive · เกณฑ์เดียวทั้งสคริปต์"
float rb_spanPct = input.float(2.0, "Cluster ทั้งระบบ · ระยะใกล้ (% ของช่วงขา)", minval = 0, maxval = 5, step = 0.25, group = RB_GROUP, active = rb_enabled or uiClusters, display = display.none)
bool rb_context = input.bool(false, "เพิ่มแนว TF ใหญ่ที่มีจุดเริ่มขาร่วมกัน", group = RB_GROUP, active = rb_enabled and not rb_parentAuto, display = display.none)
float rb_parentMinSpan = input.float(1.5, "ขนาดขาแม่ขั้นต่ำ / ขา A–B–C", minval = 1, maxval = 5, step = 0.25, group = RB_GROUP, active = rb_enabled and rb_parentAuto, display = display.none)

bool uiUsedTargets = input.bool(false, "แสดงระดับเป้าที่เคยถึงแล้ว (ย้อนหลังจาง)", group = G4, display = display.none)
bool uiArchivedTargets = input.bool(false, "แสดงชุดครบเป้า / รับช่วงแล้ว (ย้อนหลัง)", group = G4, display = display.none)

bool cleanView = visualMode == "สะอาด"
bool darkView = color.r(chart.bg_color) * 0.299 + color.g(chart.bg_color) * 0.587 + color.b(chart.bg_color) * 0.114 < 128
color UP = darkView ? #6BBFA9 : #1F7661
color DN = darkView ? #D797A2 : #A34659
color GOLD = darkView ? #E6C77B : #8D6828
color INK = darkView ? #D7DEE8 : #253449
color MUTED = darkView ? #94A2B4 : #65758A
color PANEL = darkView ? #111820 : #F4F6F9
color RULE = darkView ? #506073 : #B1BCCB
color HEAD = darkView ? #1B2531 : #E5EBF2
string labelSize = labelScale == "ใหญ่" ? size.normal : labelScale == "เล็ก" ? size.tiny : size.small
int panelTextSize = labelScale == "ใหญ่" ? 14 : labelScale == "เล็ก" ? 10 : 12
int panelTitleSize = labelScale == "ใหญ่" ? 18 : labelScale == "เล็ก" ? 13 : 16
var array<float> ratios = array.from(0.0, 0.382, 0.5, 0.618, 0.786, 1.0, 1.618, 2.0, 2.618, 3.5, 3.618, 4.236, 5.472)
type Point
    int kind = 0
    float p = na
    float r = na
    int t = na
    int i = na
    float trigger = na
    int closeT = na
    int cycle = na
    bool confirmed = false

type SwingSet
    bool valid = false
    Point a
    Point b
    Point c
    Point ref

type Episode
    int kind = 0
    float p = na
    float r = na
    int t = na
    int i = na
    float trigger = na
    int closeT = na

type Frame
    int side = 0
    int stage = 0
    bool neck = false
    bool joint = false
    Point a
    Point b
    Point c
    Point ref
    float gauge = na
    int known = na

type BookTarget
    int side = 0
    int method = 0
    float zero = na
    float span = na
    int id = na
    int zeroT = na
    int born = na
    int bornEnd = na
    float pa = na
    float pb = na
    int pat = na
    int pbt = na
    int paEnd = na
    int pbEnd = na
    int pcEnd = na
    float pref = na
    int preft = na
    float gauge = na
    bool neck = false
    bool joint = false
    float rootPrice = na
    int rootId = na
    float sourceATR = na
    float legLow = na
    float legHigh = na
    int asof = na
    float reached = 1.0
    int hit1618 = na
    int hit2000 = na
    int hit2618 = na
    int hit3500 = na
    int hit3618 = na
    int hit4236 = na
    int hit5472 = na
    int closedT = na
    int closedKind = 0
    string sourceTF = ""
    float sourceSeconds = na
    bool visible = false
    bool retained = false

