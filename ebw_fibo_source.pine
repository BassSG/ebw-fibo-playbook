    int born = na
    int asof = na
    float zero = na
    float span = na
    float rootPrice = na
    int status = 0
    int seedT = na

type BookGap
    int side = 0
    float lo = na
    float hi = na
    int born = na
    int fromT = na
    float sourceATR = na
    int known = na

type View
