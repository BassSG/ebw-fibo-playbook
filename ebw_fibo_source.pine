f_price(float p) =>
    na(p) ? "—" : str.tostring(p, format.mintick)

f_stamp(int stamp) =>
    str.format_time(stamp, "yyyy-MM-dd HH:mm", syminfo.timezone)

f_shortStamp(int stamp) =>
    str.format_time(stamp, "MM-dd HH:mm", syminfo.timezone)

f_copy(Point p) =>
    Point.new(p.kind, p.p, p.r, p.t, p.i, p.trigger, p.closeT, p.cycle, p.confirmed)

method step(Episode e, float osc, float os, float ob, float rr) =>
    Point event = Point.new()
    int zone = osc <= os ? -1 : osc >= ob ? 1 : 0
    if e.kind != 0
        bool newExtreme = e.kind == -1 ? low < e.p : high > e.p
        if newExtreme
            e.p := e.kind == -1 ? low : high
            e.r := rr
            e.t := time
            e.i := bar_index
            e.trigger := e.kind == -1 ? high[1] : low[1]
            e.closeT := time_close
        if zone != e.kind
            event := Point.new(e.kind, e.p, e.r, e.t, e.i, e.trigger, e.closeT)
            e.kind := 0
    if e.kind == 0 and zone != 0
        e.kind := zone
        e.p := zone == -1 ? low : high
        e.r := rr
        e.t := time
        e.i := bar_index
        e.trigger := zone == -1 ? high[1] : low[1]
        e.closeT := time_close
    event

type SwingHead
    int kind = 0
    float p = na
    float r = na
    int t = na
    int i = na
    float trigger = na
    int closeT = na
    int cycle = na
    bool announced = false

method track(SwingHead head, float osc, float os, float ob, float rr) =>
    Point event = Point.new()
    bool ready = not na(osc) and not na(high) and not na(low)
    int zone = not ready ? 0 : osc <= os ? -1 : osc >= ob ? 1 : 0
    if ready
        bool opposite = head.kind != 0 and zone == -head.kind
        if opposite and not head.announced
            event := Point.new(head.kind, head.p, head.r, head.t, head.i, head.trigger, head.closeT, head.cycle, true)
        if head.kind == 0 or opposite
            if zone != 0
                head.kind := zone
                head.p := zone == -1 ? low : high
                head.r := rr
                head.t := time
                head.i := bar_index
                head.trigger := zone == -1 ? high[1] : low[1]
                head.closeT := time_close
                head.cycle := time
                head.announced := false
        else
            bool newExtreme = head.kind == -1 ? low < head.p : high > head.p
            if newExtreme
                head.p := head.kind == -1 ? low : high
                head.r := rr
                head.t := time
                head.i := bar_index
                head.trigger := head.kind == -1 ? high[1] : low[1]
                head.closeT := time_close
            bool firstExit = not head.announced and zone == 0
            if firstExit or (head.announced and newExtreme)
                event := Point.new(head.kind, head.p, head.r, head.t, head.i, head.trigger, head.closeT, head.cycle, firstExit)
            if firstExit
                head.announced := true
    event

f_push(array<Point> seq, Point event, int maxPoints = 6) =>
    bool changed = false
    if event.kind != 0
        int n = seq.size()
        if n > 0 and seq.get(n - 1).kind == event.kind
            Point old = seq.get(n - 1)
            bool better = event.kind == -1 ? event.p < old.p : event.p > old.p
            if better
                seq.set(n - 1, f_copy(event))
                changed := true
        else
            seq.push(f_copy(event))
            if seq.size() > maxPoints
                seq.shift()
            changed := true
    changed

method capture(Point point, float price, int historyOffset) =>
    point.p := price
    point.r := na
    point.t := time[historyOffset]
    point.i := bar_index - historyOffset
    point.trigger := point.kind == -1 ? high[historyOffset + 1] : low[historyOffset + 1]
    point.closeT := time_close[historyOffset]
    point

f_pick_set(array<Point> seq) =>
    SwingSet picked = SwingSet.new(a = Point.new(), b = Point.new(), c = Point.new(), ref = Point.new())
    int count = seq.size()
    if count >= 3
        Point lastHead = seq.get(count - 1)
        int side = lastHead.kind == -1 ? 1 : -1
        int rootSlot = count - 3
        bool intactRoot = false
        bool rootTooOld = false
        for hop = 0 to int((count - 3) / 2)
            int slot = count - 3 - hop * 2
            Point root = seq.get(slot)
            if not na(root.i) and root.kind == lastHead.kind and root.i < lastHead.i and side * (lastHead.p - root.p) >= 0
                if bar_index - root.i < 1999
                    rootSlot := slot
                    intactRoot := true
                else
                    rootTooOld := true
                break
        Point firstHead = seq.get(rootSlot)
        Point counterHead = seq.get(rootSlot + 1)
        bool bounded = not rootTooOld and not na(firstHead.i) and not na(lastHead.i) and firstHead.i >= 0 and firstHead.i < lastHead.i and lastHead.i <= bar_index and bar_index - firstHead.i < 1999
        if bounded
            Point a = f_copy(firstHead)
            Point b = Point.new(kind = counterHead.kind, cycle = counterHead.cycle, confirmed = true)
            Point c = Point.new(kind = lastHead.kind, cycle = lastHead.cycle, confirmed = true)
            bool historyKnown = true
            for candleIndex = firstHead.i to lastHead.i
                int offset = bar_index - candleIndex
                if na(high[offset]) or na(low[offset]) or na(time[offset]) or na(time_close[offset])
                    historyKnown := false
                    break
                float headPrice = lastHead.kind == 1 ? high[offset] : low[offset]
                float counterPrice = counterHead.kind == 1 ? high[offset] : low[offset]
                bool rootExtends = intactRoot and (lastHead.kind == 1 ? headPrice > a.p : headPrice < a.p)
                if rootExtends
                    a.capture(headPrice, offset)
                    b.p := na
                    c.p := na
                bool counterExtends = na(b.p) or (counterHead.kind == 1 ? counterPrice > b.p : counterPrice < b.p)
                if counterExtends
                    b.capture(counterPrice, offset)
                    c.capture(headPrice, offset)
                else if na(c.p) or (lastHead.kind == 1 ? headPrice > c.p : headPrice < c.p)
                    c.capture(headPrice, offset)
            bool alternating = a.kind == c.kind and b.kind == -c.kind
            bool ordered = not na(b.i) and not na(c.i) and a.i < b.i and b.i < c.i and a.t < b.t and b.t < c.t
            bool geometry = side * (b.p - a.p) > 0 and side * (b.p - c.p) > 0
            if historyKnown and alternating and ordered and geometry
                Point ref = Point.new()
                for back = 1 to count
                    Point prior = seq.get(count - back)
                    if prior.kind == -a.kind and prior.i < a.i
                        ref := f_copy(prior)
                        break
                picked := SwingSet.new(true, a, b, c, ref)
    picked

f_breached(int side, float zero) =>
    side == 1 ? low < zero : side == -1 ? high > zero : false

f_break(int side, float boundary) =>
    float observed = breakMode == "Close ของแท่งปิด" ? close : side == 1 ? high : low
    side == 1 ? observed > boundary : observed < boundary

f_gauge(Point ref, Point a, Point b, int side) =>
    bool valid = not na(ref.p) and ref.t < a.t and side * (ref.p - a.p) > 0 and side * (b.p - a.p) > 0
    valid ? math.abs(b.p - a.p) / math.abs(ref.p - a.p) : na

f_method(Frame frame) =>
    frame.neck ? 3 : 1
